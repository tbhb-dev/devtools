{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The repository-level policy comes from two shared presets this repo
  // now holds itself: renovate-config.json5 has the rules plus the
  // Vale custom manager used by every repo, and
  // renovate-go-config.json5 has the Go-module specifics (gomodTidy and
  // the go-deps grouping) shared by every Go repo. Both resolve after
  // platform initialization, with token auth.
  //
  // The references stay in the remote `github>` form even though the
  // files sit beside this one. Renovate resolves `extends` over the
  // platform API rather than off a checkout, and it has no plain relative
  // file form, so a path here would not resolve at all. The remote form
  // is also exactly what every consuming repo writes, which keeps one
  // shape to reason about.
  extends: [
    "github>tbhb-dev/devtools//.github/renovate-config.json5",
    "github>tbhb-dev/devtools//.github/renovate-go-config.json5",
  ],

  // Global-only identity, rate limits, and requireConfig. These previously
  // came from renovate-global-config.json5 via globalExtends, but Renovate
  // resolves globalExtends before host rules are registered, so that preset
  // fetch was always anonymous and intermittently hit GitHub's per-IP rate
  // limit (config-presets-invalid). Inlining the resolved values removes
  // the pre-auth fetch entirely.
  requireConfig: "ignored",
  username: "tbhb-dev-renovate[bot]",
  gitAuthor: "tbhb-dev-renovate[bot] <289255489+tbhb-dev-renovate[bot]@users.noreply.github.com>",
  prConcurrentLimit: 0,
  prHourlyLimit: 0,

  // Single-repo scope. Global-only and different per repo, so it stays here
  // as the only genuinely local setting left.
  repositories: ["tbhb-dev/devtools"],

  packageRules: [
    // The Renovate engine is pinned twice: the release tag renovate.yaml
    // passes as `renovate-version`, and the validator's Docker image in
    // renovate-config-validator.yaml. Separate PRs let the two skew, and
    // the validator should run the same engine version the cron workflow
    // does, so group them into one PR. Repo-level rules append after the
    // shared preset's and later rules win, so this takes the two out of
    // the generic github-actions group.
    {
      groupName: "renovate",
      matchDepNames: [
        "renovatebot/renovate",
        "ghcr.io/renovatebot/renovate",
      ],
    },
  ],

  // Managers for the pins inside the workflows and mise config this repo
  // defines. The shared preset covers the .vale.ini markers every repo
  // has; these read files only a repo hosting the shared workflows
  // contains. `customManagers` is a mergeable array, so these append to
  // the preset's rather than replacing them.
  customManagers: [
    // Workflow `run:` steps pinning a Docker image to a
    // `<NAME>_IMAGE="reg/name:tag@sha256:..."` shell assignment, with the
    // marker on the line above. Covers the Renovate engine image in
    // renovate-config-validator.yaml and the actionlint image in
    // lint-workflows.yml; the `\S+_IMAGE` variable name keeps one matcher
    // serving every such pin.
    //
    //   # renovate: datasource=docker depName=rhysd/actionlint
    //   ACTIONLINT_IMAGE="docker.io/rhysd/actionlint:1.7.12@sha256:..."
    {
      customType: "regex",
      managerFilePatterns: [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+\\S+_IMAGE=\"[^:]+:(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)\"",
      ],
    },

    // .github/workflows/renovate.yaml. Pins the Renovate engine version
    // the self-hosted action downloads at runtime. No digest — the
    // github-action input takes a release tag, not a container ref.
    //
    //   # renovate: datasource=github-releases depName=renovatebot/renovate
    //   renovate-version: 43.281.1
    {
      customType: "regex",
      managerFilePatterns: [
        "/^\\.github/workflows/renovate\\.yaml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+renovate-version:\\s+(?<currentValue>\\S+)",
      ],
    },

    // go:-backend pins in the mise config that name a cmd/ subpackage.
    // The built-in mise manager extracts these but the go datasource
    // expects a *module* path, so a `go:` pin naming a package inside
    // the module returns no updates — silently, with no skipReason.
    // Stripping the /cmd/<name> suffix (keeping the /vN major-version
    // segment, which is part of the module path) restores resolution.
    // The built-in manager's duplicate extraction of the same pin stays
    // inert: it never produces an update for these.
    //
    //   "go:github.com/editorconfig-checker/editorconfig-checker/v3/cmd/editorconfig-checker" = "v3.9.0"
    {
      customType: "regex",
      managerFilePatterns: [
        "/^mise\\.toml$/",
        "/^\\.config/mise/conf\\.d/[^/]+\\.toml$/",
      ],
      matchStrings: [
        "\"go:(?<depName>[^\"]+)/cmd/[^\"]+\"\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
      ],
      datasourceTemplate: "go",
    },

    // The mise version the SHA-pinned jdx/mise-action installs in every
    // workflow job, marked on the line above the value. The committed
    // tools/mise-bootstrap shim embeds the same version; regenerate it
    // with `mise generate bootstrap -V <version> -w tools/mise-bootstrap`
    // when this pin moves.
    //
    //   # renovate: datasource=github-releases depName=jdx/mise
    //   version: 2026.8.0
    {
      customType: "regex",
      managerFilePatterns: [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+version:\\s+(?<currentValue>\\S+)",
      ],
    },
  ],
}
