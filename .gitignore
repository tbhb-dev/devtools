# Local development
tmp/
.env
.env.*
!.env.example
mise.local.toml

# Agent commit-message draft. Authored at the repo root so vale's
# [formats] mapping resolves it, linted via `mise run lint-commit-msg`,
# then consumed with `git commit -F COMMIT_AGENTMSG`. Never committed.
COMMIT_AGENTMSG

# Agent pull request drafts, the same idea one stage later.
# PR_AGENTDESC.md holds the description for as long as the pull request
# stays open, and merge-pr removes it once the branch merges.
# SQUASH_AGENTMSG holds the squash commit message that skill writes.
# Linted via `mise run lint-pr-description` and `mise run lint-squash-msg`.
PR_AGENTDESC.md
SQUASH_AGENTMSG

# The fix-prose skill keeps each run's baseline, original copy, and notes
# inside the worktree, because a session isolated in a linked worktree
# can't write into the git directory. The directory also ignores itself.
.fix-prose/

# Go build output
bin/
/agentcontext
/agenthooks
/agentstore
coverage.out
coverage.html
coverage.txt
coverage.xml
coverage.covdata*/

# Test outputs
testdata/fuzz/

# Python
__pycache__/
*.py[co]
.venv/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# cosmic-ray mutation session databases. The `mutate-py` recipes write
