#!/usr/bin/env bats

setup_file() {
  local source_root
  source_root=$(git -C "$BATS_TEST_DIRNAME" rev-parse --show-toplevel)
  (cd "$source_root" && go build -o "$BATS_FILE_TMPDIR/commit-lint" ./cmd/commit-lint)
}

setup() {
  export PATH="$BATS_FILE_TMPDIR:$PATH"
  source "${BATS_TEST_DIRNAME}/../../test_helper.bash"
  isolate_git
  stub_gates
  ROOT="$(cd "$BATS_TEST_DIRNAME/../../.." && pwd)"
  SCRIPTS="$ROOT/packages/agents/codex/.apm/skills/agent-commit/scripts"
  ATTENDED="$ROOT/packages/agents/codex/.apm/skills/commit/scripts"
  unset CLAUDE_CODE_SESSION_ID CODEX_THREAD_ID CLAUDECODE DEVTOOLS_HARNESS
  unset DEVTOOLS_REVIEW_MODEL DEVTOOLS_REVIEW_EFFORT DEVTOOLS_DELEGATION_CHECK DEVTOOLS_UNATTENDED
  export XDG_CONFIG_HOME="$BATS_TEST_TMPDIR/config"
  export DEVTOOLS_REVIEW_CMD='cat >/dev/null; cp "$DEVTOOLS_REVIEW_INPUTS/staged.diff" "$REVIEW_DIFF"; echo "VERDICT: PASS"'
  export REVIEW_DIFF="$BATS_TEST_TMPDIR/review.diff"
  export COMMIT_PREFLIGHT_FETCH=0
  cat >"$BATS_TEST_TMPDIR/bin/gh" <<'STUB'
#!/usr/bin/env bash
[ "$1 $2" = 'pr list' ] || exit 1
printf '%s' "${PR_BASE:-}"
STUB
  chmod +x "$BATS_TEST_TMPDIR/bin/gh"
  git init -q --bare "$BATS_TEST_TMPDIR/origin"
  git init -q --initial-branch=main "$BATS_TEST_TMPDIR/repo"
  cd "$BATS_TEST_TMPDIR/repo"
  git config user.name Tester
  git config user.email tester@example.com
  printf 'initial\n' >conflict
  git add -- conflict
  git commit -qm 'test: initial state'
  ROOT_COMMIT=$(git rev-parse HEAD)
  git remote add origin "$BATS_TEST_TMPDIR/origin"
  git checkout -qb topic
  printf 'ours\n' >conflict
  git add -- conflict
  git commit -qm 'test: branch change'
  OURS=$(git rev-parse HEAD)
  git checkout -q main
  printf 'theirs\n' >conflict
  printf 'unrelated base change\n' >unrelated
  git add -- conflict unrelated
  git commit -qm 'test: base change'
  BASE=$(git rev-parse HEAD)
  git push -q origin main
  git checkout -q topic
  git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
  ssh-keygen -q -t ed25519 -N '' -f "$BATS_TEST_TMPDIR/key"
  git config gpg.format ssh
  git config user.signingkey "$BATS_TEST_TMPDIR/key"
  for hook in pre-commit commit-msg post-commit; do
    printf '#!/usr/bin/env bash\n# File generated by prek\n' >".git/hooks/$hook"
    chmod +x ".git/hooks/$hook"
  done
  # Fixture authority, isolated from machine/session grants.
  export DEVTOOLS_DELEGATION_CHECK="$BATS_TEST_TMPDIR/checker"
  printf '#!/usr/bin/env bash\nexit 0\n' >"$DEVTOOLS_DELEGATION_CHECK"
  chmod +x "$DEVTOOLS_DELEGATION_CHECK"
  printf 'chore: merge base into topic\n\nKeep the branch current without rewriting published history.\n\nAssisted-by: codex:gpt-6.1-sol\nSigned-off-by: Tester <tester@example.com>\n' >COMMIT_AGENTMSG
}

resolve_merge() {
  run git merge --no-commit origin/main
  [ "$status" -eq 1 ]
  printf '%s\n' "${1:-resolved}" >conflict
  git add -- conflict
}

assert_merge() {
  [ "$(git show -s --format=%P HEAD)" = "$OURS $BASE" ]
  printf 'tester %s\n' "$(cat "$BATS_TEST_TMPDIR/key.pub")" >"$BATS_TEST_TMPDIR/signers"
  git -c gpg.ssh.allowedSignersFile="$BATS_TEST_TMPDIR/signers" verify-commit HEAD
  [ "$(cat "$GATE_LOG")" = $'lint-commit-msg\ndevtools:lint-leaks\ndevtools:gitleaks\nlint\ntest' ]
}

@test "agent commits the resolved base tip through review, gates and signing" {
  resolve_merge
  run bash "$SCRIPTS/preflight.sh"
  [ "$status" -eq 0 ]
  [[ "$output" == *'in progress: base merge'* ]]
  bash "$SCRIPTS/review.sh"
  grep -Fx "mode merge" .git/agent-skills/commit.stamp
  grep -Fx "merge_head $BASE" .git/agent-skills/commit.stamp
  grep -Fx "parents $OURS $BASE" .git/agent-skills/commit.stamp
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 0 ]
  assert_merge
}

@test "attended commit shares the signed base merge path" {
  resolve_merge
  run bash "$ATTENDED/preflight.sh"
  [ "$status" -eq 0 ]
  [[ "$output" == *'in progress: base merge'* ]]
  bash "$ATTENDED/review.sh"
  run bash "$ATTENDED/commit.sh"
  [ "$status" -eq 0 ]
  assert_merge
}

@test "review shows resolutions against both parents after staging, including either parent" {
  for resolution in resolved ours theirs; do
    resolve_merge "$resolution"
    bash "$SCRIPTS/review.sh"
    grep -F "Resolution against parent $OURS for conflict" "$REVIEW_DIFF"
    grep -F "Resolution against parent $BASE for conflict" "$REVIEW_DIFF"
    ! grep -F unrelated "$REVIEW_DIFF"
    if [ "$resolution" != ours ]; then grep -Fx -- '-ours' "$REVIEW_DIFF"; fi
    if [ "$resolution" != theirs ]; then grep -Fx -- '-theirs' "$REVIEW_DIFF"; fi
    git merge --abort
  done
}

@test "review includes edits outside the conflict paths" {
  resolve_merge
  printf 'manual base edit\n' >unrelated
  git add -- unrelated
  bash "$SCRIPTS/review.sh"
  grep -Fx -- '-unrelated base change' "$REVIEW_DIFF"
  grep -Fx -- '+manual base edit' "$REVIEW_DIFF"
}

@test "review includes additions outside the conflict paths" {
  resolve_merge
  printf 'manual addition\n' >extra
  git add -- extra
  bash "$SCRIPTS/review.sh"
  grep -F 'diff --git a/extra b/extra' "$REVIEW_DIFF"
  grep -Fx -- '+manual addition' "$REVIEW_DIFF"
}

@test "review includes deletions outside the conflict paths" {
  resolve_merge
  rm unrelated
  git add -- unrelated
  bash "$SCRIPTS/review.sh"
  grep -F 'diff --git a/unrelated b/unrelated' "$REVIEW_DIFF"
  grep -Fx -- '-unrelated base change' "$REVIEW_DIFF"
  grep -Fx -- '+++ /dev/null' "$REVIEW_DIFF"
}

@test "review criteria permit an empty diff only for a clean base merge" {
  git checkout -qb clean-topic "$ROOT_COMMIT"
  printf 'branch addition\n' >branch-file
  git add -- branch-file
  git commit -qm 'test: clean branch change'
  OURS=$(git rev-parse HEAD)
  cat >"$BATS_TEST_TMPDIR/reviewer" <<'STUB'
#!/usr/bin/env bash
prompt=$(cat)
if [ ! -s "$DEVTOOLS_REVIEW_INPUTS/staged.diff" ]; then
  if ! grep -Fq 'An empty staged diff is valid only for a clean base merge:' <<<"$prompt" ||
    ! grep -Fxq "Base merge: first parent $OURS; second parent $BASE." "$DEVTOOLS_REVIEW_INPUTS/merge-context.txt" ||
    ! grep -Fxq 'Clean base merge: staged tree matches the automatic merge tree; the conflict diff is empty.' "$DEVTOOLS_REVIEW_INPUTS/merge-context.txt"; then
    echo 'VERDICT: CHANGES REQUIRED'
    exit 0
  fi
fi
echo 'VERDICT: PASS'
STUB
  export OURS BASE
  export DEVTOOLS_REVIEW_CMD='bash "$BATS_TEST_TMPDIR/reviewer"'
  for scripts in "$SCRIPTS" "$ATTENDED"; do
    git merge --no-commit origin/main
    run bash "$scripts/review.sh"
    [ "$status" -eq 0 ]
    grep -Fx 'mode merge' .git/agent-skills/commit.stamp
    git merge --abort
    rm .git/agent-skills/commit.stamp
    # The same criterion must still reject an ordinary empty commit.
    run bash "$scripts/review.sh"
    [ "$status" -eq 2 ]
    [ ! -e .git/agent-skills/commit.stamp ]
  done
}

@test "other branch, older base and octopus merges hold" {
  for target in other older octopus; do
    case $target in
      other) second=$OURS ;;
      older) second=$ROOT_COMMIT ;;
      octopus) second=$(printf '%s\n%s' "$BASE" "$OURS") ;;
    esac
    printf '%s\n' "$second" >.git/MERGE_HEAD
    run bash "$SCRIPTS/review.sh"
    [ "$status" -ne 0 ]
    [[ "$output" == *'HELD: MERGE_HEAD must name only the current origin/main tip.'* ]]
  done
}

@test "rebase, cherry-pick and revert still hold in both commit paths" {
  for scripts in "$SCRIPTS" "$ATTENDED"; do
    for marker in rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD; do
      mkdir ".git/$marker"
      run bash "$scripts/review.sh"
      [ "$status" -ne 0 ]
      [[ "$output" == *"HELD: $marker is in progress"* ]]
      rmdir ".git/$marker"
    done
  done
}

@test "PR base overrides the repository default and API failures hold" {
  resolve_merge
  git branch release "$BASE"
  git push -q origin release
  git update-ref refs/remotes/origin/main "$ROOT_COMMIT"
  export PR_BASE=release
  bash "$SCRIPTS/review.sh"
  grep -Fx "merge_head $BASE" .git/agent-skills/commit.stamp
  printf '#!/usr/bin/env bash\nexit 2\n' >"$BATS_TEST_TMPDIR/bin/gh"
  run bash "$SCRIPTS/review.sh"
  [ "$status" -ne 0 ]
}

@test "fetch rejects a formerly current base tip" {
  resolve_merge
  next=$(printf 'test: newer base\n' | git commit-tree "$BASE^{tree}" -p "$BASE")
  git push -q origin "$next:refs/heads/main"
  run bash "$SCRIPTS/review.sh"
  [ "$status" -ne 0 ]
  [[ "$output" == *'HELD: MERGE_HEAD must name only the current origin/main tip.'* ]]
}

@test "changing MERGE_HEAD after review invalidates the stamp" {
  resolve_merge
  bash "$SCRIPTS/review.sh"
  # The new base is valid, but was never reviewed as the second parent.
  next=$(printf 'test: newer base\n' | git commit-tree "$BASE^{tree}" -p "$BASE")
  git push -q origin "$next:refs/heads/main"
  printf '%s\n' "$next" >.git/MERGE_HEAD
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -ne 0 ]
  [[ "$output" == *'merge_head changed after the review'* ]]
  [ "$(git rev-parse HEAD)" = "$OURS" ]
}

@test "changing MERGE_HEAD during review prevents a stamp" {
  resolve_merge
  export DEVTOOLS_REVIEW_CMD='cat >/dev/null; rm .git/MERGE_HEAD; echo "VERDICT: PASS"'
  run bash "$SCRIPTS/review.sh"
  [ "$status" -eq 5 ]
  [ ! -e .git/agent-skills/commit.stamp ]
}

@test "a broken resolution fails the gate on the merged tree" {
  resolve_merge broken
  mkdir .agents
  printf 'lint_commit_cmd = test "$(git show :conflict)" != broken\n' >.agents/agent-skills.conf
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -ne 0 ]
  [ "$(git rev-parse HEAD)" = "$OURS" ]
  [ "$(git show :conflict)" = broken ]
}

@test "verification rejects a hook replacing the second parent" {
  resolve_merge
  alternate=$(printf 'test: alternate parent\n' | git commit-tree "$BASE^{tree}" -p "$ROOT_COMMIT")
  printf '#!/usr/bin/env bash\n# File generated by prek\nprintf "%%s\\n" %s >.git/MERGE_HEAD\n' "$alternate" >.git/hooks/pre-commit
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -ne 0 ]
  [[ "$output" == *'parents differ from the reviewed parents'* ]]
  [ -e .git/agent-skills/commit.stamp ]
  [ "$(git show -s --format=%P HEAD)" = "$OURS $alternate" ]
}
