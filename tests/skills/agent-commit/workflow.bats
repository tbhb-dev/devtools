#!/usr/bin/env bats

setup_file() {
  local source_root
  source_root=$(git -C "$BATS_TEST_DIRNAME" rev-parse --show-toplevel)
  (cd "$source_root" && go build -o "$BATS_FILE_TMPDIR/commit-lint" ./cmd/commit-lint)
}

setup() {
  export PATH="$BATS_FILE_TMPDIR:$PATH"
  source "${BATS_TEST_DIRNAME}/../../test_helper.bash"
  isolate_git
  stub_gates
  ROOT="$(cd "$BATS_TEST_DIRNAME/../../.." && pwd)"
  SCRIPTS="$ROOT/packages/agents/codex/.apm/skills/agent-commit/scripts"
  unset CLAUDE_CODE_SESSION_ID CODEX_THREAD_ID CLAUDECODE DEVTOOLS_HARNESS
  unset DEVTOOLS_REVIEW_MODEL DEVTOOLS_REVIEW_EFFORT DEVTOOLS_DELEGATION_CHECK DEVTOOLS_UNATTENDED
  export XDG_CONFIG_HOME="$BATS_TEST_TMPDIR/config"
  unset DEVTOOLS_SIGNOFF_IDENTITY
  export DEVTOOLS_REVIEW_CMD='cat >/dev/null; echo "VERDICT: PASS"'
  export COMMIT_PREFLIGHT_FETCH=0
  git init -q --initial-branch=main "$BATS_TEST_TMPDIR/repo"
  cd "$BATS_TEST_TMPDIR/repo"
  git config user.name Tester
  git config user.email tester@example.com
  echo initial >tracked
  git add -- tracked
  git commit -qm 'test: initial state'
  ssh-keygen -q -t ed25519 -N '' -f "$BATS_TEST_TMPDIR/key"
  git config gpg.format ssh
  git config user.signingkey "$BATS_TEST_TMPDIR/key"
  for hook in pre-commit commit-msg post-commit; do
    printf '#!/usr/bin/env bash\n# File generated by prek\n' >".git/hooks/$hook"
    chmod +x ".git/hooks/$hook"
  done
  mkdir .agents
  echo reviewed >tracked
  git add -- tracked
  printf 'test: reviewed change\n\nSigned-off-by: Tester <tester@example.com>\n' >COMMIT_AGENTMSG
  BEFORE=$(git rev-parse HEAD)
}

@test "agent commit preflight falls back to a permitted Git identity" {
  run bash "$SCRIPTS/preflight.sh"
  [ "$status" -eq 0 ]
  grep -Fq 'Signed-off-by: Tester <tester@example.com>' <<<"$output"
}

@test "agent commit preflight guides a denied Git identity to machine configuration" {
  printf '[identities]\nagents = [{email = "tester@example.com"}]\n' >.commit-lint.toml
  run bash "$SCRIPTS/preflight.sh"
  [ "$status" -eq 1 ]
  grep -Fq 'set signoff_identity in ~/.config/devtools/<repository>.conf or ~/.config/devtools/devtools.conf' <<<"$output"
}

grant() {
  export CODEX_THREAD_ID=test-session
  mkdir -p .git/preapprovals
  printf 'commit now unconfirmed\n' >.git/preapprovals/test-session
}

@test "agent commit refuses the operator flag even with a grant" {
  grant
  run bash "$SCRIPTS/commit.sh" --confirmed
  [ "$status" -eq 1 ]
  [[ "$output" == *'refuse --confirmed'* ]]
  [ "$(git rev-parse HEAD)" = "$BEFORE" ]
}

@test "agent commit holds without authority and never asks for confirmation" {
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 75 ]
  [[ "$output" == *'without prompting'* ]]
  [[ "$output" != *'Ask the operator'* ]]
  [ "$(git rev-parse HEAD)" = "$BEFORE" ]
}

@test "agent commit signs under preapproval with all shared gates" {
  grant
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 0 ]
  [[ "$output" == *'committed:'* ]]
  [ "$(git show HEAD:tracked)" = reviewed ]
  [ ! -e .git/agent-skills/commit.stamp ]
  printf 'tester %s\n' "$(cat "$BATS_TEST_TMPDIR/key.pub")" >"$BATS_TEST_TMPDIR/signers"
  git -c gpg.ssh.allowedSignersFile="$BATS_TEST_TMPDIR/signers" verify-commit HEAD
  [ "$(cat "$GATE_LOG")" = $'lint-commit-msg\ndevtools:lint-leaks\ndevtools:gitleaks\nlint\ntest-affected' ]
}

@test "delegation refusal and deferral preserve the change, grant commits it" {
  export DEVTOOLS_DELEGATION_CHECK="$BATS_TEST_TMPDIR/checker"
  printf '#!/usr/bin/env bash\nexit "${CHECK_RESULT:-1}"\n' >"$DEVTOOLS_DELEGATION_CHECK"
  chmod +x "$DEVTOOLS_DELEGATION_CHECK"
  bash "$SCRIPTS/review.sh"
  CHECK_RESULT=1 run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 1 ]
  [ "$(git rev-parse HEAD)" = "$BEFORE" ]
  CHECK_RESULT=9 run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 75 ]
  CHECK_RESULT=0 run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 0 ]
}

@test "review findings block on the third round and do not invoke the reviewer again" {
  export DEVTOOLS_REVIEW_CMD='cat >/dev/null; echo invoked >>calls; echo "VERDICT: CHANGES REQUIRED"'
  round=0
  for expected in 2 2 3 3; do
    round=$((round + 1))
    printf 'test: reviewed change %s\n\nSigned-off-by: Tester <tester@example.com>\n' "$round" >COMMIT_AGENTMSG
    run bash "$SCRIPTS/review.sh"
    [ "$status" -eq "$expected" ]
  done
  [ "$(wc -l <calls | tr -d ' ')" = 3 ]
  [ ! -e .git/agent-skills/commit.stamp ]
}

@test "a different staged tree gets fresh finding rounds" {
  export DEVTOOLS_REVIEW_CMD='cat >/dev/null; echo "VERDICT: CHANGES REQUIRED"'
  for round in 1 2 3; do
    printf 'test: reviewed change %s\n\nSigned-off-by: Tester <tester@example.com>\n' "$round" >COMMIT_AGENTMSG
    run bash "$SCRIPTS/review.sh"
  done
  [ "$status" -eq 3 ]

  echo split >tracked
  git add -- tracked
  run bash "$SCRIPTS/review.sh"
  [ "$status" -eq 2 ]
}

@test "unreadable reviews do not spend finding rounds" {
  export DEVTOOLS_REVIEW_CMD='cat >/dev/null; echo unknown'
  run bash "$SCRIPTS/review.sh"
  [ "$status" -eq 4 ]
  [ ! -e .git/agent-skills/commit.rounds ]
}

@test "repository configuration is data and cannot choose authorities" {
  printf 'review_cmd = touch PWNED\n' >.agents/agent-skills.conf
  run bash "$SCRIPTS/review.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *'Invalid or duplicate'* ]]
  [ ! -e PWNED ]
  printf 'hook_marker = $(touch PWNED)\n' >.agents/agent-skills.conf
  run bash "$SCRIPTS/preflight.sh"
  [ "$status" -eq 1 ]
  [ ! -e PWNED ]
}

@test "configured commit lint runs and an empty command fails closed" {
  grant
  printf 'lint_commit_cmd = echo custom >>"$GATE_LOG"\n' >.agents/agent-skills.conf
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 0 ]
  grep -qx custom "$GATE_LOG"
  echo again >tracked
  git add -- tracked
  echo 'lint_commit_cmd =' >.agents/agent-skills.conf
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *'must not be empty'* ]]
}

@test "configuration changes invalidate an agent stamp" {
  bash "$SCRIPTS/review.sh"
  echo 'review_max_rounds = 2' >.agents/agent-skills.conf
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *'configuration changed after review'* ]]
}

@test "preflight refuses missing signing and missing hooks" {
  git config gpg.format invalid
  run bash "$SCRIPTS/preflight.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *'gpg.format=ssh'* ]]
  git config gpg.format ssh
  rm .git/hooks/pre-commit
  run bash "$SCRIPTS/preflight.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *'Required hook is missing'* ]]
}

@test "agent review refuses interrupted operations and detached HEAD" {
  for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
    touch ".git/$marker"
    run bash "$SCRIPTS/review.sh"
    [ "$status" -ne 0 ]
    rm ".git/$marker"
  done
  git checkout -q --detach
  run bash "$SCRIPTS/review.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *'HEAD is detached'* ]]
}

@test "hook message mutation fails verification and preserves evidence" {
  grant
  printf '#!/usr/bin/env bash\n# File generated by prek\necho changed >"$1"\n' >.git/hooks/commit-msg
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *'message differs'* ]]
  [ -e .git/agent-skills/commit.stamp ]
  [ "$(git log -1 --format=%s)" = changed ]
}

@test "signing failure holds without an unsigned fallback" {
  grant
  printf '#!/usr/bin/env bash\nexit 1\n' >"$BATS_TEST_TMPDIR/signer"
  chmod +x "$BATS_TEST_TMPDIR/signer"
  git config gpg.ssh.program "$BATS_TEST_TMPDIR/signer"
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 75 ]
  [[ "$output" == *'signing failed'* ]]
  [ "$(git rev-parse HEAD)" = "$BEFORE" ]
  [ -s COMMIT_AGENTMSG ]
}

@test "agent amend preserves parents and verifies the replacement" {
  grant
  bash "$SCRIPTS/review.sh" --amend
  run bash "$SCRIPTS/commit.sh" --amend
  [ "$status" -eq 0 ]
  [ "$(git rev-list --count HEAD)" = 1 ]
}

@test "changing configuration during review prevents stamping" {
  export DEVTOOLS_REVIEW_CMD='cat >/dev/null; echo "review_max_rounds = 2" >.agents/agent-skills.conf; echo "VERDICT: PASS"'
  run bash "$SCRIPTS/review.sh"
  [ "$status" -eq 5 ]
  [ ! -e .git/agent-skills/commit.stamp ]
}

@test "duplicate settings and a symlink configuration fail closed" {
  printf 'review_max_rounds = 2\nreview_max_rounds = 3\n' >.agents/agent-skills.conf
  run bash "$SCRIPTS/review.sh"
  [ "$status" -eq 1 ]
  mv .agents/agent-skills.conf "$BATS_TEST_TMPDIR/config-file"
  ln -s "$BATS_TEST_TMPDIR/config-file" .agents/agent-skills.conf
  run bash "$SCRIPTS/review.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *'regular file'* ]]
}

@test "hook tree mutation fails verification and preserves evidence" {
  grant
  printf '#!/usr/bin/env bash\n# File generated by prek\necho extra >extra\ngit add -- extra\n' >.git/hooks/pre-commit
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *'tree differs'* ]]
  [ -e .git/agent-skills/commit.stamp ]
}

@test "hook branch movement fails verification without undoing the hook" {
  grant
  printf '#!/usr/bin/env bash\n# File generated by prek\ngit checkout -q -b elsewhere\n' >.git/hooks/post-commit
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *'hook moved the branch or HEAD'* ]]
  [ "$(git branch --show-current)" = elsewhere ]
  [ -e .git/agent-skills/commit.stamp ]
}

@test "preflight reports the configured lint command without prompting" {
  printf 'lint_commit_cmd = custom-lint\n' >.agents/agent-skills.conf
  run bash "$SCRIPTS/preflight.sh"
  [ "$status" -eq 0 ]
  [[ "$output" == *'commit message gate: custom-lint'* ]]
  [[ "$output" == *'otherwise report the hold'* ]]
  [[ "$output" != *'confirms with the operator'* ]]
}

@test "delegation cannot switch the branch before the commit" {
  export DEVTOOLS_DELEGATION_CHECK="$BATS_TEST_TMPDIR/checker"
  printf '#!/usr/bin/env bash\ngit checkout -q -b elsewhere\n' >"$DEVTOOLS_DELEGATION_CHECK"
  chmod +x "$DEVTOOLS_DELEGATION_CHECK"
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 1 ]
  [[ "$output" == *'branch changed during the commit gates'* ]]
  [ "$(git rev-parse HEAD)" = "$BEFORE" ]
}

@test "internal unattended context does not leak into repository gates" {
  grant
  printf 'lint_commit_cmd = test -z "${DEVTOOLS_UNATTENDED:-}"\n' >.agents/agent-skills.conf
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh"
  [ "$status" -eq 0 ]
}

@test "AC6 commit scopes both leak gates to the same base without caching full lint" {
  real_mise=$(command -v mise)
  cat >"$BATS_TEST_TMPDIR/bin/mise-scoped" <<'STUB'
#!/usr/bin/env bash
if [ "$1" = run ] && { [ "$2" = lint ] || [ "$2" = devtools:lint-leaks ]; }; then
  printf '%s %s %s\n' "$2" "${DEVTOOLS_LEAK_MODE:-tree}" "${DEVTOOLS_LEAK_BASE:-unset}" >>"$SCOPE_LOG"
fi
exec "$REAL_MISE" "$@"
STUB
  chmod +x "$BATS_TEST_TMPDIR/bin/mise-scoped"
  export REAL_MISE="$real_mise" SCOPE_LOG="$BATS_TEST_TMPDIR/scopes"
  mkdir "$BATS_TEST_TMPDIR/scoped-bin"
  ln -s "$BATS_TEST_TMPDIR/bin/mise-scoped" "$BATS_TEST_TMPDIR/scoped-bin/mise"
  export PATH="$BATS_TEST_TMPDIR/scoped-bin:$PATH"
  expected=$(git rev-parse 'HEAD^{tree}')
  bash "$SCRIPTS/review.sh"
  run bash "$SCRIPTS/commit.sh" --dry-run
  [ "$status" -eq 0 ]
  [ "$(cat "$SCOPE_LOG")" = "$(printf 'devtools:lint-leaks staged %s\nlint staged %s' "$expected" "$expected")" ]
  [ ! -e ".git/agent-skills/gates/$(printf lint | shasum -a 256 | cut -d ' ' -f 1).json" ]
  : >"$SCOPE_LOG"
  expected=$(git hash-object -t tree --stdin </dev/null)
  bash "$SCRIPTS/review.sh" --amend
  run bash "$SCRIPTS/commit.sh" --amend --dry-run
  [ "$status" -eq 0 ]
  [ "$(cat "$SCOPE_LOG")" = "$(printf 'devtools:lint-leaks staged %s\nlint staged %s' "$expected" "$expected")" ]
}

@test "AC1 to AC9 commit redesign preserves the bound and rejected drafts" {
  source "${BATS_TEST_DIRNAME}/../redesign.bash"
  redesign_flow commit COMMIT_AGENTMSG "$SCRIPTS/review.sh"
}
